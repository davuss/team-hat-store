/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── Team HAT Additions ───────────────────────────────────────

# SQLite database files (Prisma / local dev)
*.db
*.db-journal
*.db-wal
*.db-shm
prisma/dev.db
prisma/dev.db-journal

# Prisma generated migrations lock (keep schema, ignore generated SQL)
# prisma/migrations/  ← keep this uncommented to track migrations

